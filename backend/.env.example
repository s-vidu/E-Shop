PORT=5000

# Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/ecommerce

# MongoDB Atlas (Cloud Database)
# Get this from MongoDB Atlas: Database > Connect > Connect your application
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority

JWT_SECRET=your-secret-key-change-in-production
NODE_ENV=development
